{
  "extends": "../buildtools/tsconfig-base.json",
  "include": [
    "*",
    "**/*",
    "../eslint-rules/**/*.js",
    "../app/client/declarations.d.ts",
    "../app/common/declarations.d.ts",
    "../app/server/declarations.d.ts",
    "../app/server/declarations/**/*.d.ts",
    "../stubs/app/server/declarations.d.ts",
    "../stubs/app/server/declarations/**/*.d.ts"
